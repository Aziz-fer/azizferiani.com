---
import SectionHeading from './SectionHeading.astro';
import { certifications, profile } from '../data/profile';
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);

const [startYear, startMonth] = profile.careerStart.split('-').map(Number);
const now = new Date();
const years = Math.floor((now.getFullYear() * 12 + now.getMonth() + 1 - (startYear * 12 + startMonth)) / 12);

const stats = [
  { value: years, suffix: '+', label: ui.about.stats.years },
  { value: profile.repoCount, suffix: '', label: ui.about.stats.repos },
  { value: certifications.length, suffix: '', label: ui.about.stats.certs },
  { value: 1, suffix: '', label: ui.about.stats.novel },
];

const facts = [
  { label: ui.about.facts.based, value: profile.facts.based[locale] },
  { label: ui.about.facts.languages, value: profile.facts.languages[locale] },
  { label: ui.about.facts.studied, value: profile.facts.studied[locale] },
  { label: ui.about.facts.offClock, value: profile.facts.offClock[locale] },
];
---

<section id="about" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionHeading kicker={ui.about.kicker} title={ui.about.title} />

    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr]">
      <div class="space-y-5 text-lg leading-relaxed text-muted" data-stagger="120">
        {profile.about[locale].map((p) => <p data-reveal>{p}</p>)}
      </div>

      <dl class="glass grid content-start gap-5 rounded-3xl p-7" data-reveal="scale">
        {
          facts.map((f) => (
            <div class="border-b border-line pb-4 last:border-0 last:pb-0">
              <dt class="text-xs font-semibold tracking-[0.18em] text-accent uppercase">{f.label}</dt>
              <dd class="mt-1.5">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <ul class="mt-14 grid grid-cols-2 gap-4 lg:grid-cols-4" data-stagger="100">
      {
        stats.map((s) => (
          <li class="stat glass rounded-3xl p-6 text-center" data-reveal data-spotlight>
            <p class="font-display text-5xl font-semibold sm:text-6xl">
              <span class="text-gold-gradient">
                <span data-count={s.value}>{s.value}</span>
                {s.suffix}
              </span>
            </p>
            <p class="mt-2 text-sm text-muted">{s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stat {
    position: relative;
    overflow: hidden;
  }

  .stat::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), var(--glow), transparent 60%);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .stat:hover::before {
    opacity: 0.6;
  }
</style>
