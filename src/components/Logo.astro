---
interface Props {
  size?: number;
  class?: string;
}
const { size = 32, class: className = '' } = Astro.props;
const gid = `logo-gold-${Math.random().toString(36).slice(2, 8)}`;
const fill = `url(#${gid})`;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 64 64"
  width={size}
  height={size}
  class={className}
  aria-hidden="true"
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#f3d9a4"></stop>
      <stop offset="1" stop-color="#e9a87a"></stop>
    </linearGradient>
  </defs>
  <circle cx="32" cy="32" r="30" fill="none" stroke={fill} stroke-width="2" opacity="0.55"></circle>
  <path
    d="M27 12h10M28.5 12v6.5c-7.5 2-10.5 8.5-8.5 16.5 2 7.5 7 12.5 12 19 5-6.5 10-11.5 12-19 2-8-1-14.5-8.5-16.5V12"
    fill={fill}
    stroke={fill}
    stroke-width="1.5"
    stroke-linejoin="round"></path>
  <path
    d="M28.5 15c-6 0-7.5 6-4.5 9.5M35.5 15c6 0 7.5 6 4.5 9.5"
    fill="none"
    stroke={fill}
    stroke-width="2.4"
    stroke-linecap="round"></path>
  <path d="M23 30.5c6 2 12 2 18 0" fill="none" stroke="#b5562d" stroke-width="1.6" stroke-linecap="round" opacity="0.8"></path>
</svg>
