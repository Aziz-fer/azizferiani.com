---
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookCover3D from '../components/BookCover3D.astro';
import Icon from '../components/Icon.astro';
import TranslationNote from '../components/TranslationNote.astro';
import { localePath, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  book: CollectionEntry<'books'>;
}

const { locale, book } = Astro.props;
const ui = t(locale);
const b = book.data;
const { Content } = await render(book);
const site = Astro.site?.href ?? 'https://azizferiani.com/';

const backdrop = await getImage({ src: b.cover, width: 600, format: 'webp' });
const gallery = await Promise.all(
  b.gallery.map(async (g) => ({ ...g, full: (await getImage({ src: g.src, width: 1500, format: 'webp' })).src })),
);

const paragraphs = (text: string) => text.split(/\n\s*\n/).map((p) => p.trim());
const title = locale === 'ar' ? `${b.title} · ${b.author}` : `${b.titleTranslations[locale]} (${b.title}) · ${b.authorLatin}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  name: b.title,
  alternateName: [b.titleTranslations.en, b.titleTranslations.de],
  author: { '@type': 'Person', name: b.author, alternateName: b.authorLatin, url: site },
  inLanguage: b.lang,
  genre: b.genre.en,
  numberOfPages: b.pages,
  datePublished: String(b.year),
  bookFormat: 'https://schema.org/EBook',
  description: b.blurb.en,
  isAccessibleForFree: true,
  url: new URL(localePath(locale, `books/${book.id}/`), site).href,
};
---

<Base
  locale={locale}
  title={title}
  description={b.tagline[locale]}
  path={`books/${book.id}/`}
  image={`/og-${book.id}.png`}
  imageAlt={b.title}
  type="book"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="book-hero relative isolate overflow-hidden pt-32 pb-24 sm:pt-40">
    <div class="book-backdrop" style={`background-image: url(${backdrop.src})`} aria-hidden="true"></div>
    <div class="mx-auto grid max-w-6xl items-center gap-16 px-4 sm:px-6 lg:grid-cols-[1fr_1.2fr]">
      <div class="flex justify-center" data-reveal="scale">
        <BookCover3D cover={b.cover} alt={b.title} width={340} rtl={b.lang === 'ar'} eager />
      </div>

      <div class="text-center lg:text-start">
        <div data-reveal>
          <a href={localePath(locale, 'books/')} class="inline-flex items-center gap-2 text-sm text-muted hover:text-accent">
            <Icon name="chevron-left" size={16} class="rtl:-scale-x-100" />
            {ui.bookPage.back}
          </a>
        </div>
        <p class="kicker mt-6 justify-center lg:justify-start" data-reveal>{b.genre[locale]}</p>
        <h1
          class="mt-4 text-[clamp(3rem,8vw,5.2rem)] leading-[1.2] text-gold-gradient"
          style="font-family: var(--font-ruqaa); --d: 100ms"
          lang={b.lang}
          data-reveal
        >
          {b.title}
        </h1>
        {
          locale !== b.lang && (
            <p class="font-display mt-1 text-2xl italic text-muted sm:text-3xl" data-reveal style="--d: 150ms">
              {b.titleTranslations[locale]}
            </p>
          )
        }
        <p class="mt-5 text-lg" data-reveal style="--d: 200ms">
          {ui.bookPage.by}
          <span lang="ar" class="mx-1 text-accent" style="font-family: var(--font-arabic)">{b.author}</span>
          {locale !== 'ar' && <span class="text-muted">({b.authorLatin})</span>}
        </p>
        <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-muted lg:mx-0" data-reveal style="--d: 260ms">
          {b.tagline[locale]}
        </p>

        <ul class="mt-8 flex flex-wrap justify-center gap-2 lg:justify-start" data-reveal style="--d: 320ms">
          <li class="pill"><strong>{b.pages}</strong> {ui.bookPage.pages}</li>
          <li class="pill"><strong>{b.chapters}</strong> {ui.bookPage.chapters}</li>
          <li class="pill"><strong>{b.gallery.length}</strong> {ui.bookPage.illustrations}</li>
          <li class="pill">{ui.bookPage.language}: <strong>{ui.bookPage.arabic}</strong></li>
        </ul>
        {
          b.translationsComing && (
            <div class="mt-4" data-reveal style="--d: 350ms">
              <TranslationNote locale={locale} />
            </div>
          )
        }

        <div class="mt-10 flex flex-wrap items-center justify-center gap-3 lg:justify-start" data-reveal style="--d: 380ms">
          <a class="btn btn-primary download" href={b.pdf.href} download={b.pdf.downloadName}>
            <Icon name="download" size={20} />
            <span class="text-start">
              <span class="block">{ui.book.download}</span>
              <span class="block text-xs font-medium opacity-75">PDF · {b.pdf.size}</span>
            </span>
          </a>
          <a class="btn btn-ghost" href="#opening">{ui.bookPage.opening}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- About the novel -->
  <section class="py-20">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="kicker" data-reveal>{ui.bookPage.about}</p>
        <div class="mt-6 space-y-5 text-lg leading-relaxed" data-stagger="100">
          {paragraphs(b.blurb[locale]).map((p) => <p data-reveal>{p}</p>)}
        </div>
      </div>
      {
        locale !== 'ar' && (
          <aside class="glass self-start rounded-3xl p-7" data-reveal="scale" lang="ar" dir="rtl">
            <p class="text-sm font-semibold text-accent" lang={locale} dir="ltr">
              {ui.bookPage.originalBlurb}
            </p>
            <div class="mt-4 space-y-4 text-lg leading-loose" style="font-family: var(--font-arabic)">
              {paragraphs(b.blurb.ar).map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </aside>
        )
      }
    </div>
  </section>

  <!-- Opening pages -->
  <section id="opening" class="py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <div class="text-center" data-reveal><p class="kicker">{ui.bookPage.opening}</p></div>
      <article class="excerpt glass mt-8 rounded-[2rem] px-6 py-12 sm:px-14" lang={b.lang} dir="rtl" data-reveal>
        <p class="excerpt-ornament" aria-hidden="true">✦</p>
        <div class="prose-ar text-[1.2rem] leading-[2.1]" style="font-family: var(--font-arabic)">
          <Content />
        </div>
        <div class="excerpt-fade" aria-hidden="true"></div>
      </article>
      <div class="mt-10 flex justify-center" data-reveal>
        <a class="btn btn-primary" href={b.pdf.href} download={b.pdf.downloadName}>
          <Icon name="download" size={18} />
          {ui.book.download}
        </a>
      </div>
    </div>
  </section>

  <!-- Illustrations -->
  {
    gallery.length > 0 && (
      <section class="py-20">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <p class="kicker" data-reveal>
            {ui.bookPage.gallery}
          </p>
          <ul class="gallery mt-8" data-stagger="50">
            {gallery.map((g) => (
              <li data-reveal>
                <button
                  type="button"
                  class="gallery-item"
                  data-lightbox-item
                  data-full={g.full}
                  data-caption={g.caption}
                  data-chapter-label={`${ui.bookPage.chapter} ${g.chapter}`}
                  aria-label={g.caption}
                >
                  <Image src={g.src} alt={g.caption} width={640} class="gallery-img" />
                  <span class="gallery-caption" lang="ar" dir="rtl">
                    <span class="block text-xs opacity-70" lang={locale} dir="auto">
                      {ui.bookPage.chapter} {g.chapter}
                    </span>
                    {g.caption}
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>

        <dialog class="lightbox" data-lightbox aria-label={ui.bookPage.gallery}>
          <div class="lightbox-inner">
            <button type="button" class="lightbox-close" data-lightbox-close aria-label={ui.bookPage.close}>
              <Icon name="close" size={22} />
            </button>
            <img data-lightbox-img alt="" class="lightbox-img" />
            <div class="lightbox-bar">
              <button type="button" class="lightbox-nav" data-lightbox-prev aria-label={ui.bookPage.prev}>
                <Icon name="chevron-left" size={22} class="rtl:-scale-x-100" />
              </button>
              <div class="min-w-0 flex-1 text-center">
                <p data-lightbox-caption lang="ar" dir="rtl" class="text-lg" style="font-family: var(--font-arabic)" />
                <p data-lightbox-meta class="text-sm text-muted" />
              </div>
              <button type="button" class="lightbox-nav" data-lightbox-next aria-label={ui.bookPage.next}>
                <Icon name="chevron-right" size={22} class="rtl:-scale-x-100" />
              </button>
            </div>
          </div>
        </dialog>
      </section>
    )
  }
</Base>

<style>
  .book-backdrop {
    position: absolute;
    inset: -10%;
    z-index: -1;
    background-size: cover;
    background-position: center;
    filter: blur(70px) saturate(130%);
    opacity: 0.35;
    -webkit-mask: linear-gradient(180deg, #000 40%, transparent);
    mask: linear-gradient(180deg, #000 40%, transparent);
  }

  :global(:root[data-theme='dawn']) .book-backdrop {
    opacity: 0.22;
  }

  .pill {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.9rem;
    color: var(--muted);
    border: 1px solid var(--border);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }

  .pill strong {
    color: var(--text);
    font-weight: 700;
  }

  .download {
    padding: 0.9rem 1.6rem;
  }

  .excerpt {
    position: relative;
    overflow: hidden;
  }

  .excerpt-ornament {
    text-align: center;
    color: var(--gold);
    font-size: 1.4rem;
    margin-bottom: 1.5rem;
  }

  .excerpt-fade {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 6rem;
    background: linear-gradient(180deg, transparent, var(--surface-strong));
    pointer-events: none;
  }

  .gallery {
    columns: 1;
    column-gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .gallery {
      columns: 2;
    }
  }

  @media (min-width: 1024px) {
    .gallery {
      columns: 3;
    }
  }

  .gallery li {
    break-inside: avoid;
    margin-bottom: 1.25rem;
  }

  .gallery-item {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 1.25rem;
    border: 1px solid var(--border);
    cursor: zoom-in;
    box-shadow: var(--shadow);
  }

  .gallery-item :global(.gallery-img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.8s var(--ease-out-expo);
  }

  .gallery-item:hover :global(.gallery-img) {
    transform: scale(1.06);
  }

  .gallery-caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 2.5rem 1.1rem 1rem;
    color: #f7e8c9;
    font-family: var(--font-arabic);
    font-size: 1.05rem;
    line-height: 1.6;
    text-align: start;
    background: linear-gradient(180deg, transparent, rgb(10 12 30 / 0.85));
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.4s ease,
      transform 0.4s var(--ease-out-expo);
  }

  .gallery-item:hover .gallery-caption,
  .gallery-item:focus-visible .gallery-caption {
    opacity: 1;
    transform: none;
  }

  @media (pointer: coarse) {
    .gallery-caption {
      opacity: 1;
      transform: none;
    }
  }

  .lightbox {
    max-width: min(96vw, 1100px);
    max-height: 96vh;
    width: 100%;
    margin: auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 1.5rem;
    background: var(--surface-strong);
    color: var(--text);
    box-shadow: 0 40px 120px -20px rgb(0 0 0 / 0.7);
  }

  .lightbox::backdrop {
    background: rgb(5 7 20 / 0.82);
    backdrop-filter: blur(6px);
  }

  .lightbox[open] {
    animation: pop 0.35s var(--ease-out-expo);
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.96);
    }
  }

  .lightbox-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: 96vh;
  }

  .lightbox-img {
    display: block;
    width: 100%;
    max-height: calc(96vh - 7rem);
    object-fit: contain;
    background: #0a0d22;
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }

  .lightbox-nav,
  .lightbox-close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: var(--surface-strong);
    color: var(--text);
    cursor: pointer;
    transition:
      border-color 0.3s ease,
      color 0.3s ease;
  }

  .lightbox-nav:hover,
  .lightbox-close:hover {
    border-color: var(--gold);
    color: var(--accent-text);
  }

  .lightbox-close {
    position: absolute;
    top: 0.9rem;
    inset-inline-end: 0.9rem;
    z-index: 1;
  }
</style>
