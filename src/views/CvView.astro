---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import photo from '../assets/aziz.jpg';
import { certifications, journey, profile, skillGroups, spokenLanguages } from '../data/profile';
import { projects } from '../data/projects';
import { formatMonth, localePath, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const work = journey.filter((j) => j.type === 'work');
const education = journey.filter((j) => j.type === 'education');
const cvProjects = projects.filter((p) => p.cv);

const period = (start: string, end: string | undefined, yearsOnly?: boolean) => {
  const fmt = (ym: string) => (yearsOnly ? ym.slice(0, 4) : formatMonth(ym, locale));
  return `${fmt(start)} – ${end ? fmt(end) : ui.journey.present}`;
};

/** The printed label must be the real address: "https://www.x.com/a/" → "x.com/a". */
const bare = (url: string) => url.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '');

const contacts = [
  { icon: 'mail', label: profile.email, href: `mailto:${profile.email}` },
  { icon: 'globe', label: 'azizferiani.com', href: 'https://azizferiani.com' },
  { icon: 'linkedin', label: bare(profile.links.linkedin), href: profile.links.linkedin },
  { icon: 'github', label: bare(profile.links.github), href: profile.links.github },
  { icon: 'pin', label: profile.facts.based[locale], href: undefined },
] as const;
---

<Base locale={locale} title={ui.meta.cvTitle} description={ui.meta.cvDescription} path="cv/">
  <div class="mx-auto max-w-[900px] px-3 pt-28 pb-10 sm:px-6 sm:pt-32 print:max-w-none print:p-0">
    <div class="no-print mb-6 flex flex-wrap items-center justify-between gap-3">
      <a href={localePath(locale, '')} class="inline-flex items-center gap-2 text-sm text-muted hover:text-accent">
        <Icon name="chevron-left" size={16} class="rtl:-scale-x-100" />
        {ui.cv.back}
      </a>
      <button type="button" class="btn btn-primary" onclick="window.print()">
        <Icon name="printer" size={18} />
        {ui.cv.save}
      </button>
    </div>

    <article class="paper">
      <header class="flex flex-col items-center gap-6 border-b border-[#e4dccb] pb-7 text-center sm:flex-row sm:text-start">
        <Image src={photo} alt={profile.name[locale]} width={200} height={200} class="h-24 w-24 shrink-0 rounded-full object-cover" />
        <div class="min-w-0">
          <h1 class="cv-name">{profile.name[locale]}</h1>
          <p class="mt-1 text-lg font-semibold text-[#8a5a1a]">{profile.role[locale]}</p>
          <ul class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-1 text-[0.85rem] text-[#4a5070] sm:justify-start">
            {
              contacts.map((c) => (
                <li class="inline-flex items-center gap-1.5">
                  <Icon name={c.icon} size={13} />
                  {c.href ? (
                    <a href={c.href} dir="ltr" class="hover:underline">
                      {c.label}
                    </a>
                  ) : (
                    <span>{c.label}</span>
                  )}
                </li>
              ))
            }
          </ul>
        </div>
      </header>

      <section class="mt-6">
        <h2 class="cv-h2">{ui.cv.summary}</h2>
        <p class="leading-relaxed">{profile.intro[locale]}</p>
      </section>

      <div class="mt-2 grid gap-x-10 md:grid-cols-[1.75fr_1fr] print:grid-cols-[1.75fr_1fr]">
        <div>
          <section class="mt-6">
            <h2 class="cv-h2">{ui.cv.experience}</h2>
            {
              work.map((w) => (
                <div class="cv-entry">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                    <h3 class="font-bold">{w.role[locale]}</h3>
                    <span class="text-[0.82rem] text-[#4a5070] tabular-nums">{period(w.start, w.end)}</span>
                  </div>
                  <p class="text-[0.9rem] font-semibold text-[#8a5a1a]">
                    {w.org} · {w.location[locale]}
                  </p>
                  <ul class="cv-list">
                    {w.points[locale].map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </section>

          <section class="mt-6">
            <h2 class="cv-h2">{ui.cv.education}</h2>
            {
              education.map((e) => (
                <div class="cv-entry">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                    <h3 class="font-bold">{e.role[locale]}</h3>
                    <span class="text-[0.82rem] text-[#4a5070] tabular-nums">{period(e.start, e.end, e.yearsOnly)}</span>
                  </div>
                  <p class="text-[0.9rem] font-semibold text-[#8a5a1a]">
                    {e.org} · {e.location[locale]}
                  </p>
                  <ul class="cv-list">
                    {e.points[locale].map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </section>

          <section class="mt-6">
            <h2 class="cv-h2">{ui.cv.projects}</h2>
            {
              cvProjects.map((p) => (
                <div class="cv-entry">
                  <h3 class="font-bold">{p.title[locale]}</h3>
                  <p class="text-[0.9rem] leading-relaxed">{p.description[locale]}</p>
                  <p class="mt-1 text-[0.78rem] text-[#4a5070]" dir="ltr">
                    {p.tags.join(' · ')}
                  </p>
                </div>
              ))
            }
          </section>
        </div>

        <aside>
          <section class="mt-6">
            <h2 class="cv-h2">{ui.cv.skills}</h2>
            {
              skillGroups.map((g) => (
                <div class="mb-3">
                  <h3 class="text-[0.85rem] font-bold">{g.title[locale]}</h3>
                  <p class="text-[0.85rem] leading-relaxed text-[#4a5070]" dir="ltr">
                    {g.items.join(' · ')}
                  </p>
                </div>
              ))
            }
          </section>

          <section class="mt-6">
            <h2 class="cv-h2">{ui.cv.languages}</h2>
            <ul class="space-y-1 text-[0.88rem]">
              {
                spokenLanguages.map((l) => (
                  <li class="flex justify-between gap-2">
                    <span class="font-semibold">{l.name[locale]}</span>
                    <span class="text-[#4a5070]">{l.level[locale]}</span>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="mt-6">
            <h2 class="cv-h2">{ui.cv.certifications}</h2>
            <ul class="space-y-2 text-[0.84rem]" dir="ltr" lang="en">
              {
                certifications.map((c) => (
                  <li>
                    <span class="font-semibold">{c.name}</span>
                    {c.honors && ' ★'}
                    <span class="block text-[#4a5070]">
                      {c.issuer} · <span dir="auto">{formatMonth(c.date, locale)}</span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </section>
        </aside>
      </div>
    </article>
  </div>
</Base>

<style>
  .paper {
    background: #fffdf8;
    color: #1d2550;
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 5vw, 3.25rem);
    box-shadow: 0 40px 100px -30px rgb(0 0 0 / 0.55);
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }

  :global(:root[lang='ar']) .paper {
    font-family: var(--font-arabic);
    font-size: 1.02rem;
  }

  .cv-name {
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 700;
    line-height: 1;
  }

  :global(:root[lang='ar']) .cv-name {
    font-family: var(--font-ruqaa);
    line-height: 1.3;
  }

  .cv-h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.8rem;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #8a5a1a;
    break-after: avoid;
  }

  :global(:root[lang='ar']) .cv-h2 {
    letter-spacing: 0;
    font-size: 1rem;
  }

  .cv-h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: #e4dccb;
  }

  .cv-entry {
    margin-bottom: 1rem;
    break-inside: avoid;
  }

  .cv-list {
    margin-top: 0.35rem;
    padding-inline-start: 1.1rem;
    list-style: disc;
    line-height: 1.55;
  }

  .cv-list li::marker {
    color: #b8863b;
  }

  .cv-list li + li {
    margin-top: 0.2rem;
  }

  @media print {
    .paper {
      background: #fff;
      box-shadow: none;
      border-radius: 0;
      padding: 0;
      font-size: 9.5pt;
    }
    .cv-name {
      font-size: 24pt;
    }
  }
</style>
