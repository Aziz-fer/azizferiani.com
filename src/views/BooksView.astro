---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BookCover3D from '../components/BookCover3D.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import TranslationNote from '../components/TranslationNote.astro';
import { localePath, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = t(locale);
const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
---

<Base locale={locale} title={ui.meta.booksTitle} description={ui.meta.booksDescription} path="books/">
  <section class="pt-36 pb-16 sm:pt-44">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <SectionHeading kicker={ui.books.kicker} title={ui.books.title} intro={ui.books.intro} as="h1" />

      <ul class="shelf grid gap-x-10 gap-y-20 pt-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger="120">
        {
          books.map((book) => (
            <li class="flex flex-col items-center text-center" data-reveal>
              <a href={localePath(locale, `books/${book.id}/`)} class="group block" aria-label={book.data.title}>
                <BookCover3D cover={book.data.cover} alt={book.data.title} width={240} rtl={book.data.lang === 'ar'} eager />
              </a>
              <h2 class="mt-12 text-3xl leading-snug" style="font-family: var(--font-ruqaa)" lang={book.data.lang} dir="auto">
                <a href={localePath(locale, `books/${book.id}/`)} class="hover:text-accent">
                  {book.data.title}
                </a>
              </h2>
              {locale !== book.data.lang && (
                <p class="font-display text-xl italic text-muted">{book.data.titleTranslations[locale]}</p>
              )}
              <p class="mt-2 text-sm text-muted">
                {book.data.genre[locale]} · {book.data.year} · {book.data.pages} {ui.bookPage.pages}
              </p>
              {book.data.translationsComing && <TranslationNote locale={locale} class="mt-4" />}
              <div class="mt-6 flex flex-wrap justify-center gap-2">
                <a class="btn btn-primary !px-5 !py-3 text-sm" href={localePath(locale, `books/${book.id}/`)}>
                  {ui.books.read}
                </a>
                <a class="btn btn-ghost !px-5 !py-3 text-sm" href={book.data.pdf.href} download={book.data.pdf.downloadName}>
                  <Icon name="download" size={16} />
                  {ui.book.downloadShort}
                </a>
              </div>
            </li>
          ))
        }
        <li class="flex flex-col items-center text-center" data-reveal>
          <div class="ghost-book" aria-hidden="true">
            <Icon name="sparkle" size={30} />
          </div>
          <p class="font-display mt-12 text-2xl italic text-muted">{ui.books.next}</p>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .ghost-book {
    display: grid;
    place-items: center;
    width: min(240px, 72vw);
    aspect-ratio: 1500 / 2251;
    border-radius: 6px;
    border: 2px dashed var(--border-strong);
    color: var(--gold);
    background: color-mix(in srgb, var(--surface) 50%, transparent);
    animation: ghost 4s ease-in-out infinite;
  }

  @keyframes ghost {
    0%,
    100% {
      opacity: 0.55;
    }
    50% {
      opacity: 1;
    }
  }
</style>
